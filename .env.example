# Restaurant AI Agent Environment Configuration
# Copy this file to .env and configure as needed.

# Application Settings
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
DEBUG=True

# LLM Provider Configuration
# Supported options: 'auto', 'gemini', 'openai', 'mock'
# If set to 'auto', it picks gemini if GEMINI_API_KEY is set, else openai if OPENAI_API_KEY is set, else 'mock' (offline rule/pattern engine).
LLM_PROVIDER=auto

# Google Gemini API Key (Optional)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OpenAI API Key (Optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Database Path
DATABASE_PATH=restaurant.db

# RAG & Similarity Configuration
EMBEDDING_MODEL=all-MiniLM-L6-v2
RAG_SIMILARITY_THRESHOLD=0.55
RAG_TOP_K=3

# Guardrails & Safety
MAX_AGENT_ITERATIONS=5
ENABLE_PROMPT_INJECTION_SHIELD=True
ENABLE_AUTHORIZATION_CHECKS=True

# API Simulation Flags
SIMULATE_ORDER_API_FAILURE=False
ORDER_API_TIMEOUT_SECONDS=5.0
